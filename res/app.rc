#pragma code_page(65001)
#include <winver.h>

// App icon by nik-txt (app.svg, made by make_icon.py): white for the exe and dark themes, black for light ones.
1 ICON "app.ico"
2 ICON "app_light.ico"
1 24 "app.manifest"

// The built-in UI languages: lang\*.txt joined by the build (see src/i18n.cpp).
LANGS RCDATA "languages.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Wireless Battery Monitor"
      VALUE "ProductName", "Wireless Battery Monitor"
      VALUE "FileVersion", "1.0.1"
      VALUE "ProductVersion", "1.0.1"
      VALUE "OriginalFilename", "WirelessBattery.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
